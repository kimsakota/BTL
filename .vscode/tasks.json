{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xv6: build",
      "type": "process",
      "command": "make",
      "args": ["kernel/kernel", "fs.img"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd",
          "${workspaceFolder}",
          "--exec",
          "make",
          "kernel/kernel",
          "fs.img"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "xv6: run",
      "type": "process",
      "command": "make",
      "args": ["qemu", "CPUS=${input:xv6Cpus}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": [
          "--cd",
          "${workspaceFolder}",
          "--exec",
          "make",
          "qemu",
          "CPUS=${input:xv6Cpus}"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "xv6: clean",
      "type": "process",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "wsl.exe",
        "args": ["--cd", "${workspaceFolder}", "--exec", "make", "clean"]
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "xv6Cpus",
      "type": "pickString",
      "description": "Số vCPU cho xv6",
      "options": ["1", "2", "4", "8"],
      "default": "1"
    }
  ]
}
